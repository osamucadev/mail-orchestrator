{
  // ============================================================
  // Google OAuth 2.0 Client credentials (WEB application)
  // ============================================================
  //
  // This file is an EXAMPLE.
  //
  // Do NOT put real credentials here.
  // - Prefer downloading the valid JSON from Google Cloud Console.
  // - Save that download as backend/secrets/credentials.json.
  // - This annotated JSONC is documentation, not a runtime credentials file.
  // - If adapting it manually, remove every comment and replace placeholders.
  // - Never commit `credentials.json`
  //
  // This project uses a local FastAPI backend to handle OAuth.
  // The redirect URI MUST match the backend callback exactly.
  //
  // ============================================================
  // HOW TO CREATE THESE CREDENTIALS (STEP BY STEP)
  // ============================================================
  //
  // 1. Go to Google Cloud Console
  //    https://console.cloud.google.com/
  //
  // 2. Create a new project (or select an existing one)
  //    - Click the project selector (top bar)
  //    - Click "New Project"
  //    - Give it a name (e.g. "Mail Orchestrator")
  //    - Create
  //
  // 3. Enable the Gmail API
  //    - Go to "APIs & Services" -> "Library"
  //    - Search for "Gmail API"
  //    - Click "Enable"
  //
  // 4. Configure OAuth consent screen
  //    - Go to "APIs & Services" -> "OAuth consent screen"
  //    - Choose "External"
  //    - Click "Create"
  //
  //    Fill the required fields:
  //    - App name: Mail Orchestrator (or whatever you want)
  //    - User support email: your email
  //    - Developer contact email: your email
  //
  //    Scopes:
  //    - Add:
  //      https://www.googleapis.com/auth/gmail.send
  //      https://www.googleapis.com/auth/gmail.readonly
  //
  //    Test users:
  //    - In testing mode, add each Gmail account you intend to connect.
  //
  //    Complete the configuration; local testing does not require publishing.
  //    Console labels can change. See the current web-server OAuth guide:
  //    https://developers.google.com/identity/protocols/oauth2/web-server
  //
  // 5. Create OAuth Client ID
  //    - Go to "APIs & Services" -> "Credentials"
  //    - Click "Create Credentials"
  //    - Choose "OAuth client ID"
  //
  //    Application type:
  //    - Web application
  //
  //    Name:
  //    - Mail Orchestrator (local)
  //
  //    Authorized JavaScript origins (optional):
  //    - http://localhost:5173
  //
  //    Authorized redirect URIs (REQUIRED):
  //    - http://localhost:8000/api/auth/callback
  //
  //    IMPORTANT:
  //    The redirect URI must match EXACTLY.
  //    For this local configuration, keep the same scheme, port and path.
  //
  // 6. Download the credentials JSON
  //    - After creating the client, click "Download JSON"
  //    - Rename it to `credentials.json`
  //    - Place it in:
  //      backend/secrets/credentials.json
  //
  // 7. Create a `.env` file in `backend/`
  //    Example:
  //
  //    GOOGLE_OAUTH_CLIENT_SECRETS_FILE=./secrets/credentials.json
  //    GOOGLE_OAUTH_TOKEN_FILE=./secrets/token.json
  //    FRONTEND_ORIGIN=http://localhost:5173
  //    Optional: ACCOUNT_TOKEN_KEY_FILE=./secrets/account-token.key
  //    GOOGLE_OAUTH_TOKEN_FILE is legacy; active tokens are encrypted in SQLite.
  //    GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback
  //    GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.readonly
  //
  // 8. Run the app and authenticate
  //    - Start backend and frontend.
  //    - Visit http://localhost:5173 and click Open Gmail Login.
  //    - Authorize in the popup or use Continue login in this tab.
  //    - Use Add / reconnect account for additional Gmail accounts.
  //    - Login must begin in the same browser that receives the callback.
  //    - Data requests need the session cookie and X-Account-ID.
  //    - Mutations, including starting login, require the frontend Origin.
  //
  // ============================================================
  // EXPECTED RESULT
  // ============================================================
  //
  // - Google redirects to:
  //   http://localhost:8000/api/auth/callback
  //
  // - Backend stores each account's encrypted credentials in SQLite.
  // - The encryption key is normally backend/secrets/account-token.key.
  // - Back up database, key and uploaded files together; never commit them.
  // - The old token.json is preserved but no longer used for authentication.
  //
  // - GET /api/auth/status lists accounts connected in this browser.
  // - Original data belongs to srcaetite@gmail.com; reconnect it after upgrade.
  //
  // ============================================================

  "web": {
    // OAuth client ID generated by Google
    "client_id": "SAMUELCAETITE",

    // GCP project ID
    "project_id": "SAMUELCAETITE",

    // OAuth endpoints (do not change)
    "auth_uri": "https://accounts.google.com/o/oauth2/auth",
    "token_uri": "https://oauth2.googleapis.com/token",

    // Certificate URL (do not change)
    "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",

    // OAuth client secret generated by Google
    "client_secret": "SAMUELCAETITE",

    // MUST match the backend callback exactly
    "redirect_uris": ["http://localhost:8000/api/auth/callback"]
  }
}
