# Development values; Docker uses compose.yml environment entries.
DATABASE_URL=sqlite:///./data/mail_orchestrator.db
FRONTEND_ORIGIN=http://localhost:5173
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=./secrets/credentials.json
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.readonly
# Legacy location: tokens are now encrypted per account in SQLite.
# This path determines the default directory for account-token.key.
GOOGLE_OAUTH_TOKEN_FILE=./secrets/token.json
# Optional override; back up this key with the database.
# ACCOUNT_TOKEN_KEY_FILE=./secrets/account-token.key
